{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/load-platform.js\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__bridgeai__(execute_sql|remove_resource|provision_resource|remove_app|rollback_deploy|apply_migration)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/require-approval.js\""
          }
        ]
      },
      {
        "matcher": "^(Bash|PowerShell)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/check-push.js\""
          }
        ]
      }
    ]
  }
}
